{
  "name": "english-path",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "prebuild": "npm run check:data",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:data": "node scripts/check-data.mjs",
    "desktop": "electron .",
    "build:icons": "node scripts/create-desktop-icon.mjs",
    "build:voice-pack": "node scripts/build-voice-pack.mjs",
    "build:installer-images": "node scripts/create-installer-images.mjs",
    "build:setup": "npm run build:icons && npm run build:installer-images && npm run build && electron-builder --win nsis --x64 --config electron-builder.json"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "main": "desktop/main.cjs",
  "description": "English Path — английский: карточки слов, неправильные глаголы и грамматика",
  "author": "English Path"
}
